---
layout: null
permalink: /pt-br/feed.xml
lang: pt-BR
---
{%- assign strings = site.data.i18n["pt-BR"] -%}
{%- assign posts = site.posts | where: "lang", "pt-BR" -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="pt-BR">
  <title>{{ strings.feed.title | xml_escape }}</title>
  <subtitle>{{ strings.feed.description | xml_escape }}</subtitle>
  <link href="{{ '/pt-br/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/pt-br/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/pt-br/' | absolute_url }}</id>
  <updated>{{ posts.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for post in posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
